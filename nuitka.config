# Nuitka configuration for MindType

# --standalone is default for our builds
standalone = true

# Plugin for PyQt6
enable-plugins = ["pyqt6"]

# Include the main app package
include-packages = ["app"]

# Data files
include-data-dir = ["app/assets=app/assets"]

# Third-party packages to include
include-packages = [
    "huggingface_hub",
    "sklearn",
    "librosa",
    "soundfile",
    "psutil",
    "onnxruntime"
]

# Modules to include
include-modules = [
    "sounddevice",
    "numpy",
    "ctypes"
]

# Windows specific
[windows]
console-mode = "disable"
icon = "assets/icons/app.ico"
company-name = "MindType"
product-name = "MindType"

# macOS specific
[macos]
create-app-bundle = true
app-icon = "assets/icons/app.png"
app-name = "MindType"

# Linux specific
[linux]
onefile-icon = "assets/icons/app.png"

