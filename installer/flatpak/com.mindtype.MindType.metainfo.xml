<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.mindtype.MindType</id>
  <name>MindType</name>
  <summary>Offline speech-to-text transcription</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>Proprietary</project_license>

  <description>
    <p>
      MindType is a desktop application for transcribing speech to text
      using OpenAI's Whisper AI model. It works completely offline without
      sending any data to external servers.
    </p>
    <p>Key features:</p>
    <ul>
      <li>Push-to-talk recording with customizable global hotkey</li>
      <li>Support for multiple Whisper models (tiny, small, medium, large)</li>
      <li>Auto-paste transcribed text directly to any application</li>
      <li>Multi-language support with automatic language detection</li>
      <li>Voice Activity Detection (VAD) for smart recording</li>
      <li>System tray integration for quick access</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.mindtype.MindType.desktop</launchable>

  <url type="homepage">https://mindtype.app</url>
  <url type="bugtracker">https://github.com/mindtype/mindtype/issues</url>

  <provides>
    <binary>mindtype</binary>
  </provides>

  <screenshots>
    <screenshot type="default">
      <caption>MindType main window</caption>
      <image>https://mindtype.app/screenshots/main.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>speech</keyword>
    <keyword>voice</keyword>
    <keyword>transcription</keyword>
    <keyword>whisper</keyword>
    <keyword>dictation</keyword>
    <keyword>ai</keyword>
  </keywords>

  <releases>
    <release version="1.0.0" date="2024-01-01">
      <description>
        <p>Initial release</p>
      </description>
    </release>
  </releases>
</component>












